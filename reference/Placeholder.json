{
  "openapi": "3.0.3",
  "info": {
    "title": "JSONPlaceholder Sandbox API",
    "description": "Tiny OpenAPI sandbox for testing a ReadMe custom MDX live endpoint tester. Uses JSONPlaceholder, a free fake REST API for testing and prototyping.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://jsonplaceholder.typicode.com",
      "description": "JSONPlaceholder public sandbox API"
    }
  ],
  "tags": [
    {
      "name": "Posts",
      "description": "Fake post resources"
    },
    {
      "name": "Users",
      "description": "Fake user resources"
    },
    {
      "name": "Comments",
      "description": "Fake comment resources"
    }
  ],
  "paths": {
    "/posts": {
      "get": {
        "tags": [
          "Posts"
        ],
        "summary": "List posts",
        "description": "Returns a list of fake posts.",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": false,
            "description": "Optional user ID filter.",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of posts.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Post"
                  }
                },
                "example": [
                  {
                    "userId": 1,
                    "id": 1,
                    "title": "sunt aut facere repellat provident occaecati excepturi optio reprehenderit",
                    "body": "quia et suscipit suscipit recusandae consequuntur expedita et cum"
                  }
                ]
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Posts"
        ],
        "summary": "Create a post",
        "description": "Creates a fake post. JSONPlaceholder returns a simulated created response, but the data is not persisted.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewPost"
              },
              "example": {
                "title": "Hello from ReadMe MDX",
                "body": "This is a sandbox request body.",
                "userId": 1
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Fake created post response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                },
                "example": {
                  "title": "Hello from ReadMe MDX",
                  "body": "This is a sandbox request body.",
                  "userId": 1,
                  "id": 101
                }
              }
            }
          }
        }
      }
    },
    "/posts/{id}": {
      "get": {
        "tags": [
          "Posts"
        ],
        "summary": "Get a post",
        "description": "Returns one fake post by ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Post ID.",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A single post.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                },
                "example": {
                  "userId": 1,
                  "id": 1,
                  "title": "sunt aut facere repellat provident occaecati excepturi optio reprehenderit",
                  "body": "quia et suscipit suscipit recusandae consequuntur expedita et cum"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Posts"
        ],
        "summary": "Replace a post",
        "description": "Replaces a fake post. The response is simulated and not persisted.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Post ID.",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewPost"
              },
              "example": {
                "id": 1,
                "title": "Updated from ReadMe MDX",
                "body": "Updated sandbox request body.",
                "userId": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fake updated post response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                },
                "example": {
                  "id": 1,
                  "title": "Updated from ReadMe MDX",
                  "body": "Updated sandbox request body.",
                  "userId": 1
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Posts"
        ],
        "summary": "Delete a post",
        "description": "Deletes a fake post. The response is simulated and not persisted.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Post ID.",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fake deleted post response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {}
              }
            }
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get a user",
        "description": "Returns one fake user by ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "User ID.",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A single user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                },
                "example": {
                  "id": 1,
                  "name": "Leanne Graham",
                  "username": "Bret",
                  "email": "Sincere@april.biz"
                }
              }
            }
          }
        }
      }
    },
    "/comments": {
      "get": {
        "tags": [
          "Comments"
        ],
        "summary": "List comments",
        "description": "Returns fake comments, optionally filtered by post ID.",
        "parameters": [
          {
            "name": "postId",
            "in": "query",
            "required": false,
            "description": "Optional post ID filter.",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of comments.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Comment"
                  }
                },
                "example": [
                  {
                    "postId": 1,
                    "id": 1,
                    "name": "id labore ex et quam laborum",
                    "email": "Eliseo@gardner.biz",
                    "body": "laudantium enim quasi est quidem magnam voluptate ipsam eos"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Post": {
        "type": "object",
        "required": [
          "userId",
          "id",
          "title",
          "body"
        ],
        "properties": {
          "userId": {
            "type": "integer",
            "example": 1
          },
          "id": {
            "type": "integer",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Hello from ReadMe MDX"
          },
          "body": {
            "type": "string",
            "example": "This is a sandbox post body."
          }
        }
      },
      "NewPost": {
        "type": "object",
        "required": [
          "title",
          "body",
          "userId"
        ],
        "properties": {
          "title": {
            "type": "string",
            "example": "Hello from ReadMe MDX"
          },
          "body": {
            "type": "string",
            "example": "This is a sandbox request body."
          },
          "userId": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Leanne Graham"
          },
          "username": {
            "type": "string",
            "example": "Bret"
          },
          "email": {
            "type": "string",
            "example": "Sincere@april.biz"
          }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "postId": {
            "type": "integer",
            "example": 1
          },
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "id labore ex et quam laborum"
          },
          "email": {
            "type": "string",
            "example": "Eliseo@gardner.biz"
          },
          "body": {
            "type": "string",
            "example": "laudantium enim quasi est quidem magnam voluptate ipsam eos"
          }
        }
      }
    }
  }
}