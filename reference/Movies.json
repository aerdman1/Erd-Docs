{
  "openapi": "3.0.3",
  "info": {
    "title": "MovieStore API",
    "version": "1.0.0",
    "description": "Tiny demo API for movies, people, and reviews."
  },
  "servers": [
    {
      "url": "https://api.moviestore.example/v1"
    }
  ],
  "tags": [
    {
      "name": "Movies",
      "description": "Browse and manage movies"
    },
    {
      "name": "People",
      "description": "Actors, directors, crew"
    },
    {
      "name": "Reviews",
      "description": "User reviews per movie"
    },
    {
      "name": "Auth",
      "description": "Authentication"
    },
    {
      "name": "System",
      "description": "Health & utilities"
    }
  ],
  "paths": {
    "/auth/token": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Obtain access token",
        "description": "Exchange client credentials for a short-lived Bearer token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "clientId",
                  "clientSecret"
                ],
                "properties": {
                  "clientId": {
                    "type": "string"
                  },
                  "clientSecret": {
                    "type": "string"
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "read",
                        "write"
                      ]
                    }
                  }
                },
                "additionalProperties": false
              },
              "examples": {
                "default": {
                  "value": {
                    "clientId": "demo",
                    "clientSecret": "s3cr3t",
                    "scopes": [
                      "read"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token issued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "access_token",
                    "token_type",
                    "expires_in"
                  ],
                  "properties": {
                    "access_token": {
                      "type": "string",
                      "example": "eyJhbGciOi..."
                    },
                    "token_type": {
                      "type": "string",
                      "example": "Bearer"
                    },
                    "expires_in": {
                      "type": "integer",
                      "example": 3600
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "security": []
      }
    },
    "/movies": {
      "get": {
        "tags": [
          "Movies"
        ],
        "summary": "List movies",
        "parameters": [
          {
            "$ref": "#/components/parameters/Q"
          },
          {
            "$ref": "#/components/parameters/Year"
          },
          {
            "$ref": "#/components/parameters/Genre"
          },
          {
            "$ref": "#/components/parameters/Sort"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated movies",
            "headers": {
              "X-Total-Count": {
                "description": "Total number of matching items",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoviePage"
                },
                "examples": {
                  "ok": {
                    "value": {
                      "items": [
                        {
                          "id": "mv_1001",
                          "title": "Space Cats",
                          "year": 2024,
                          "genres": [
                            "Sci-Fi",
                            "Comedy"
                          ],
                          "rating": 7.8
                        }
                      ],
                      "page": 1,
                      "pageSize": 25
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Movies"
        ],
        "summary": "Create a movie",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewMovie"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Movie"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/movies/{id}": {
      "get": {
        "tags": [
          "Movies"
        ],
        "summary": "Get movie details",
        "parameters": [
          {
            "$ref": "#/components/parameters/MovieId"
          }
        ],
        "responses": {
          "200": {
            "description": "Movie found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Movie"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "tags": [
          "Movies"
        ],
        "summary": "Update a movie (partial)",
        "parameters": [
          {
            "$ref": "#/components/parameters/MovieId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "year": {
                    "type": "integer",
                    "minimum": 1888,
                    "maximum": 2100
                  },
                  "genres": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "rating": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Movie"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "Movies"
        ],
        "summary": "Delete a movie",
        "parameters": [
          {
            "$ref": "#/components/parameters/MovieId"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/movies/{id}/poster": {
      "post": {
        "tags": [
          "Movies"
        ],
        "summary": "Upload or replace poster image",
        "parameters": [
          {
            "$ref": "#/components/parameters/MovieId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "JPEG or PNG poster"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Poster uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "width": {
                      "type": "integer"
                    },
                    "height": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/movies/{id}/reviews": {
      "get": {
        "tags": [
          "Reviews"
        ],
        "summary": "List reviews for a movie",
        "parameters": [
          {
            "$ref": "#/components/parameters/MovieId"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated reviews",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewPage"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "tags": [
          "Reviews"
        ],
        "summary": "Create a review",
        "parameters": [
          {
            "$ref": "#/components/parameters/MovieId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewReview"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Review created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Review"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/people": {
      "get": {
        "tags": [
          "People"
        ],
        "summary": "List people",
        "parameters": [
          {
            "$ref": "#/components/parameters/Q"
          },
          {
            "name": "role",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "actor",
                "director",
                "writer",
                "producer"
              ]
            },
            "description": "Filter by primary role"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated people",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonPage"
                }
              }
            }
          }
        }
      }
    },
    "/people/{personId}": {
      "get": {
        "tags": [
          "People"
        ],
        "summary": "Get person details",
        "parameters": [
          {
            "$ref": "#/components/parameters/PersonId"
          }
        ],
        "responses": {
          "200": {
            "description": "Person found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Person"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Include `Authorization: Bearer <token>`"
      }
    },
    "parameters": {
      "MovieId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^mv_[a-zA-Z0-9]+$"
        },
        "description": "Movie identifier"
      },
      "PersonId": {
        "name": "personId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^pr_[a-zA-Z0-9]+$"
        },
        "description": "Person identifier"
      },
      "Q": {
        "name": "q",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Free-text search query"
      },
      "Year": {
        "name": "year",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1888,
          "maximum": 2100
        }
      },
      "Genre": {
        "name": "genre",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "Action",
            "Comedy",
            "Drama",
            "Fantasy",
            "Horror",
            "Romance",
            "Sci-Fi",
            "Thriller"
          ]
        }
      },
      "Sort": {
        "name": "sort",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "title.asc",
            "title.desc",
            "year.asc",
            "year.desc",
            "rating.desc"
          ]
        },
        "description": "Sort order"
      },
      "Page": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Invalid credentials",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Movie": {
        "type": "object",
        "required": [
          "id",
          "title",
          "year",
          "genres"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "mv_1001"
          },
          "title": {
            "type": "string",
            "example": "Space Cats"
          },
          "year": {
            "type": "integer",
            "example": 2024
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "example": 7.8
          },
          "summary": {
            "type": "string",
            "nullable": true
          },
          "cast": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Credit"
            }
          }
        }
      },
      "NewMovie": {
        "type": "object",
        "required": [
          "title",
          "year",
          "genres"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "minimum": 1888
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "summary": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Credit": {
        "type": "object",
        "required": [
          "personId",
          "name",
          "role"
        ],
        "properties": {
          "personId": {
            "type": "string",
            "example": "pr_42"
          },
          "name": {
            "type": "string",
            "example": "Ada Lovelace"
          },
          "role": {
            "type": "string",
            "example": "Director"
          },
          "character": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Review": {
        "type": "object",
        "required": [
          "id",
          "movieId",
          "author",
          "rating",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "rv_9001"
          },
          "movieId": {
            "type": "string",
            "example": "mv_1001"
          },
          "author": {
            "type": "string",
            "example": "jane.doe"
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "example": 5
          },
          "title": {
            "type": "string",
            "example": "Loved it"
          },
          "body": {
            "type": "string",
            "example": "Surprisingly heartfelt and funny."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "NewReview": {
        "type": "object",
        "required": [
          "author",
          "rating"
        ],
        "properties": {
          "author": {
            "type": "string"
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Person": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "pr_42"
          },
          "name": {
            "type": "string",
            "example": "Ada Lovelace"
          },
          "birthYear": {
            "type": "integer",
            "nullable": true
          },
          "knownFor": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "Space Cats"
            ]
          }
        }
      },
      "MoviePage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Movie"
            }
          },
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          }
        }
      },
      "ReviewPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Review"
            }
          },
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          }
        }
      },
      "PersonPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Person"
            }
          },
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}