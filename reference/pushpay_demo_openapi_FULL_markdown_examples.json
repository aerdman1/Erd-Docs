{
  "openapi": "3.0.3",
  "info": {
    "title": "Pushpay API Demo (ReadMe Example)",
    "version": "1.0.0",
    "description": "Minimal OpenAPI spec used to demo multiple response examples per endpoint in ReadMe."
  },
  "servers": [
    {
      "url": "https://api.pushpay.com",
      "description": "Production"
    },
    {
      "url": "https://sandbox.api.pushpay.com",
      "description": "Sandbox (example)"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Settlements",
      "description": "Settlement and payment settlement endpoints (demo subset)."
    }
  ],
  "paths": {
    "/v1/merchant/{merchantKey}/settlements": {
      "get": {
        "tags": [
          "Settlements"
        ],
        "summary": "List settlements",
        "description": "Returns a paged list of settlements for a merchant.\n\n### Common filters\n| Filter | Type | Notes |\n|---|---|---|\n| `type` | string | `CreditCard` or `ACH` |\n| `isReconciled` | boolean | `true` to only show reconciled settlements |\n| `page` / `pageSize` | number | Pagination controls |\n\n### Notes\n- This table is **Markdown stored inside the OpenAPI `description`** field.\n- Useful for quick “mini docs” on the endpoint without editing the page in ReadMe.\n",
        "operationId": "listSettlements",
        "parameters": [
          {
            "name": "merchantKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Merchant key."
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "CreditCard",
                "ACH"
              ]
            },
            "description": "Filter by settlement type.\n\n| Value | Meaning |\n|---|---|\n| `CreditCard` | Card settlements |\n| `ACH` | Bank transfer settlements |\n"
          },
          {
            "name": "isReconciled",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Filter by reconciled flag.\n\n**Tip:** If you set this to `true`, you’ll only see settlements that have been reconciled.\n"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "description": "Page index (0-based)."
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "description": "Page size."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/SettlementsRepresentation"
                },
                "examples": {
                  "basic": {
                    "summary": "Basic settlements list (page 0)",
                    "value": {
                      "page": 0,
                      "pageSize": 25,
                      "total": 2,
                      "totalPages": 1,
                      "items": [
                        {
                          "key": "SETTLEMENT_KEY_0",
                          "name": "Settlement #0",
                          "totalAmount": {
                            "amount": "1250.50",
                            "currency": "USD"
                          },
                          "type": "CreditCard",
                          "totalPayments": 42,
                          "estimatedDepositDate": "2015-01-03T07:00:00Z",
                          "isReconciled": true,
                          "_links": {
                            "self": {
                              "href": "https://api.pushpay.com/v1/settlement/SETTLEMENT_KEY_0"
                            },
                            "payments": {
                              "href": "https://api.pushpay.com/v1/settlement/SETTLEMENT_KEY_0/payments"
                            }
                          }
                        },
                        {
                          "key": "SETTLEMENT_KEY_1",
                          "name": "Settlement #1",
                          "totalAmount": {
                            "amount": "85.12",
                            "currency": "USD"
                          },
                          "type": "ACH",
                          "totalPayments": 3,
                          "estimatedDepositDate": "2015-01-04T07:00:00Z",
                          "isReconciled": false,
                          "_links": {
                            "self": {
                              "href": "https://api.pushpay.com/v1/settlement/SETTLEMENT_KEY_1"
                            },
                            "payments": {
                              "href": "https://api.pushpay.com/v1/settlement/SETTLEMENT_KEY_1/payments"
                            }
                          }
                        }
                      ],
                      "_links": {
                        "self": {
                          "href": "https://api.pushpay.com/v1/merchant/MERCHANT_KEY/settlements?page=0&pageSize=25"
                        }
                      }
                    }
                  },
                  "empty": {
                    "summary": "No results (filters return empty set)",
                    "value": {
                      "page": 0,
                      "pageSize": 25,
                      "total": 0,
                      "totalPages": 0,
                      "items": [],
                      "_links": {
                        "self": {
                          "href": "https://api.pushpay.com/v1/merchant/MERCHANT_KEY/settlements?type=CreditCard&isReconciled=true&page=0&pageSize=25"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "missingToken": {
                    "summary": "Missing/invalid bearer token",
                    "value": {
                      "message": "Unauthorized",
                      "code": "unauthorized"
                    }
                  }
                }
              }
            }
          }
        },
        "x-readme": {
          "code-samples": [
            {
              "language": "curl",
              "code": "curl -H \"Authorization: Bearer <token>\" \\\n  \"https://api.pushpay.com/v1/merchant/<merchantKey>/settlements?type=CreditCard&isReconciled=true&page=0&pageSize=25\""
            }
          ]
        }
      }
    },
    "/v1/settlement/{settlementKey}": {
      "get": {
        "tags": [
          "Settlements"
        ],
        "summary": "Get a settlement",
        "operationId": "getSettlement",
        "parameters": [
          {
            "name": "settlementKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Settlement key."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/Settlement"
                },
                "examples": {
                  "creditCard": {
                    "summary": "Credit card settlement example",
                    "value": {
                      "key": "SETTLEMENT_KEY_0",
                      "name": "Settlement #0",
                      "totalAmount": {
                        "amount": "1250.50",
                        "currency": "USD"
                      },
                      "type": "CreditCard",
                      "totalPayments": 42,
                      "estimatedDepositDate": "2015-01-03T07:00:00Z",
                      "isReconciled": true,
                      "_links": {
                        "self": {
                          "href": "https://api.pushpay.com/v1/settlement/SETTLEMENT_KEY_0"
                        },
                        "payments": {
                          "href": "https://api.pushpay.com/v1/settlement/SETTLEMENT_KEY_0/payments"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "notFound": {
                    "summary": "Unknown settlement key",
                    "value": {
                      "message": "Settlement not found",
                      "code": "not_found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/settlement/{settlementKey}/payments": {
      "get": {
        "tags": [
          "Settlements"
        ],
        "summary": "List settlement payments",
        "operationId": "listSettlementPayments",
        "parameters": [
          {
            "name": "settlementKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Settlement key."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/SettlementPaymentsRepresentation"
                },
                "examples": {
                  "basic": {
                    "summary": "Payments for a settlement (page 0)",
                    "value": {
                      "page": 0,
                      "pageSize": 25,
                      "total": 2,
                      "totalPages": 1,
                      "items": [
                        {
                          "paymentKey": "PAYMENT_KEY_0",
                          "amount": {
                            "amount": "50.00",
                            "currency": "USD"
                          },
                          "createdDate": "2015-01-02T12:34:56Z",
                          "status": "Settled",
                          "_links": {
                            "self": {
                              "href": "https://api.pushpay.com/v1/payment/PAYMENT_KEY_0"
                            }
                          }
                        },
                        {
                          "paymentKey": "PAYMENT_KEY_1",
                          "amount": {
                            "amount": "75.12",
                            "currency": "USD"
                          },
                          "createdDate": "2015-01-02T13:14:10Z",
                          "status": "Settled",
                          "_links": {
                            "self": {
                              "href": "https://api.pushpay.com/v1/payment/PAYMENT_KEY_1"
                            }
                          }
                        }
                      ],
                      "_links": {
                        "self": {
                          "href": "https://api.pushpay.com/v1/settlement/SETTLEMENT_KEY_0/payments?page=0&pageSize=25"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/merchant/{merchantKey}/settlements/search": {
      "post": {
        "tags": [
          "Settlements"
        ],
        "summary": "Search settlements (demo for requestBody examples)",
        "description": "Demo endpoint to show **requestBody examples** and Markdown-in-spec rendering in ReadMe.\n\n### Request fields\n| Field | Type | Description |\n|---|---|---|\n| `type` | string | Settlement type filter |\n| `isReconciled` | boolean | Reconciled filter |\n| `estimatedDepositDateFrom/To` | string(date-time) | Date range filter |\n| `page` / `pageSize` | number | Pagination |\n\n### Why this exists\n- GET endpoints usually don’t have a `requestBody`.\n- This POST is only to demonstrate request-body examples in the API Reference.\n",
        "operationId": "searchSettlements",
        "parameters": [
          {
            "name": "merchantKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Merchant key."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettlementSearchRequest"
              },
              "examples": {
                "basic": {
                  "summary": "Search by type + reconciled",
                  "value": {
                    "type": "CreditCard",
                    "isReconciled": true,
                    "page": 0,
                    "pageSize": 25
                  }
                },
                "dateRange": {
                  "summary": "Search by deposit date range",
                  "value": {
                    "estimatedDepositDateFrom": "2015-01-01T00:00:00Z",
                    "estimatedDepositDateTo": "2015-01-31T23:59:59Z",
                    "page": 0,
                    "pageSize": 25
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/SettlementsRepresentation"
                },
                "examples": {
                  "basic": {
                    "summary": "Results for CreditCard reconciled search",
                    "value": {
                      "page": 0,
                      "pageSize": 25,
                      "total": 1,
                      "totalPages": 1,
                      "items": [
                        {
                          "key": "SETTLEMENT_KEY_0",
                          "name": "Settlement #0",
                          "totalAmount": {
                            "amount": "1250.50",
                            "currency": "USD"
                          },
                          "type": "CreditCard",
                          "totalPayments": 42,
                          "estimatedDepositDate": "2015-01-03T07:00:00Z",
                          "isReconciled": true,
                          "_links": {
                            "self": {
                              "href": "https://api.pushpay.com/v1/settlement/SETTLEMENT_KEY_0"
                            },
                            "payments": {
                              "href": "https://api.pushpay.com/v1/settlement/SETTLEMENT_KEY_0/payments"
                            }
                          }
                        }
                      ],
                      "_links": {
                        "self": {
                          "href": "https://api.pushpay.com/v1/merchant/MERCHANT_KEY/settlements/search"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalidRange": {
                    "summary": "Invalid date range",
                    "value": {
                      "message": "estimatedDepositDateFrom must be <= estimatedDepositDateTo",
                      "code": "invalid_request"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "missingToken": {
                    "summary": "Missing/invalid bearer token",
                    "value": {
                      "message": "Unauthorized",
                      "code": "unauthorized"
                    }
                  }
                }
              }
            }
          }
        },
        "x-readme": {
          "code-samples": [
            {
              "language": "curl",
              "code": "curl -H \"Authorization: Bearer <token>\" -H \"Content-Type: application/json\" \\\n  -d '{\"type\":\"CreditCard\",\"isReconciled\":true,\"page\":0,\"pageSize\":25}' \\\n  https://api.pushpay.com/v1/merchant/<merchantKey>/settlements/search"
            },
            {
              "language": "javascript",
              "code": "fetch('https://api.pushpay.com/v1/merchant/<merchantKey>/settlements/search', {\n  method: 'POST',\n  headers: {\n    'Authorization': 'Bearer <token>',\n    'Content-Type': 'application/json'\n  },\n  body: JSON.stringify({ type: 'CreditCard', isReconciled: true, page: 0, pageSize: 25 })\n});"
            }
          ]
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Send `Authorization: Bearer <token>`."
      }
    },
    "schemas": {
      "Money": {
        "type": "object",
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "string",
            "example": "1250.50"
          },
          "currency": {
            "type": "string",
            "example": "USD"
          }
        },
        "additionalProperties": false
      },
      "Link": {
        "type": "object",
        "required": [
          "href"
        ],
        "properties": {
          "href": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      },
      "HalLinks": {
        "type": "object",
        "properties": {
          "self": {
            "$ref": "#/components/schemas/Link"
          },
          "payments": {
            "$ref": "#/components/schemas/Link"
          }
        },
        "additionalProperties": true
      },
      "Settlement": {
        "type": "object",
        "required": [
          "key",
          "name",
          "totalAmount",
          "type",
          "totalPayments",
          "estimatedDepositDate",
          "isReconciled"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "totalAmount": {
            "$ref": "#/components/schemas/Money"
          },
          "type": {
            "type": "string",
            "enum": [
              "CreditCard",
              "ACH"
            ]
          },
          "totalPayments": {
            "type": "integer"
          },
          "estimatedDepositDate": {
            "type": "string",
            "format": "date-time"
          },
          "isReconciled": {
            "type": "boolean"
          },
          "_links": {
            "$ref": "#/components/schemas/HalLinks"
          }
        },
        "additionalProperties": false,
        "description": "A single settlement record.\n\n### Common fields\n| Field | Notes |\n|---|---|\n| `totalAmount` | Monetary amount + currency |\n| `estimatedDepositDate` | ISO8601 date-time |\n| `_links` | HAL links (self, payments, etc.) |\n"
      },
      "SettlementsRepresentation": {
        "type": "object",
        "required": [
          "page",
          "pageSize",
          "total",
          "totalPages",
          "items"
        ],
        "properties": {
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Settlement"
            }
          },
          "_links": {
            "type": "object",
            "properties": {
              "self": {
                "$ref": "#/components/schemas/Link"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false,
        "description": "Paged settlements response.\n\n### Pagination fields\n| Field | Meaning |\n|---|---|\n| `page` | 0-based page index |\n| `pageSize` | items per page |\n| `total` | total items |\n| `totalPages` | total pages |\n"
      },
      "SettlementPayment": {
        "type": "object",
        "required": [
          "paymentKey",
          "amount",
          "createdDate",
          "status"
        ],
        "properties": {
          "paymentKey": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "createdDate": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "_links": {
            "type": "object",
            "properties": {
              "self": {
                "$ref": "#/components/schemas/Link"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "SettlementPaymentsRepresentation": {
        "type": "object",
        "required": [
          "page",
          "pageSize",
          "total",
          "totalPages",
          "items"
        ],
        "properties": {
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SettlementPayment"
            }
          },
          "_links": {
            "type": "object",
            "properties": {
              "self": {
                "$ref": "#/components/schemas/Link"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "required": [
          "message",
          "code"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SettlementSearchRequest": {
        "type": "object",
        "description": "Demo request body used to showcase **requestBody examples** in ReadMe.\n\n### Example patterns\n- Filter by `type` and `isReconciled`\n- Filter by date range using `estimatedDepositDateFrom` and `estimatedDepositDateTo`\n",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "CreditCard",
              "ACH"
            ],
            "description": "Filter by settlement type."
          },
          "isReconciled": {
            "type": "boolean",
            "description": "Filter by reconciled flag."
          },
          "estimatedDepositDateFrom": {
            "type": "string",
            "format": "date-time",
            "description": "Start of deposit date range (inclusive)."
          },
          "estimatedDepositDateTo": {
            "type": "string",
            "format": "date-time",
            "description": "End of deposit date range (inclusive)."
          },
          "page": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25
          }
        },
        "additionalProperties": false
      }
    }
  }
}