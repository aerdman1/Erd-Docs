{
  "openapi": "3.0.3",
  "info": {
    "title": "Image Response Test",
    "version": "1.0.0",
    "description": "Test endpoint to see how Try It Out handles PNG binary responses."
  },
  "servers": [
    {
      "url": "https://httpbin.org"
    }
  ],
  "paths": {
    "/image/png": {
      "get": {
        "summary": "Return a PNG image",
        "description": "Simple test endpoint that returns a PNG image so we can verify how binary responses render in Try It Out.",
        "operationId": "getTestPng",
        "responses": {
          "200": {
            "description": "PNG image response",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    }
  }
}